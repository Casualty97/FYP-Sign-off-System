# Dependencies
node_modules/

# Runtime output: never commit
*.log
logs/
backend/cache/
uploads/photos/*
uploads/processed/*
!uploads/photos/.gitkeep
!uploads/processed/.gitkeep

# Secrets and certificates: never commit new ones.
# backend/.env and backend/certs/ are still tracked from the previous team; untracking them is a separate, later step.
backend/.env
backend/.env.*
!backend/.env.example
backend/certs/

# Large model file that nothing references
assets/Tree/tree.glb

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime settings written by the admin page (seeded from backend/config/defaults/)
backend/data/
