# Copy to backend/.env and fill in. Keys with no value fall back to the defaults shown in the comments.
# Nothing here is read until the servers load backend/.env (startAll.js runs from the project root).

# --- Database (defaults match what Datastore_Assembly.js creates) ---
DB_HOST=localhost
DB_USER=kiosk_user
DB_PASSWORD=kiosk123
DB_NAME=dp_kiosk_db

# --- Security ---
# 64 hex characters (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes already-stored visitor emails unreadable.
ENCRYPTION_KEY=
# Random text for the admin login cookie.
SESSION_SECRET=

# --- Network ---
# IP that phones must use (goes into the QR code). Leave empty to auto-detect from PREFERRED_INTERFACE or the first adapter.
SERVER_IP=
# Adapter name to prefer when SERVER_IP is empty (default: Wi-Fi 2).
PREFERRED_INTERFACE=
# <Jun Kai start>
# Port of the main HTTPS server (default 3000). Lets a second copy run next to a live one for testing.
PORT=
# <Jun Kai end>
# Address the HTTPS server binds to (default: 0.0.0.0).
BIND_HOST=

# <Jun Kai start>
# --- Kiosk automation and logging ---
# on (default) | off | dry-run. Use off on a laptop or a test copy: the policies then never hibernate the PC and never
# set the Windows wake timer. dry-run only prints what it would do.
KIOSK_AUTOMATION=on
# Empty: the terminal shows startup lines, real actions, warnings and errors. debug also shows every request.
LOG_LEVEL=
# <Jun Kai end>

# --- Pledge sentiment (feedbackRoutes -> pledgeSentiment.js) ---
# rules | local | online | hybrid (default hybrid). "rules" needs no model download.
PLEDGE_SENTIMENT_MODE=hybrid
# Optional online provider: openai | groq | custom. Leave empty to skip the online step.
AI_SENTIMENT_PROVIDER=
AI_SENTIMENT_API_URL=
AI_SENTIMENT_API_KEY=
AI_SENTIMENT_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Pulse ---
# Campaign goal shown on the pulse page (number of feedback entries).
PULSE_CAMPAIGN_GOAL=

# --- Email ---
# Only shown by the /api/test-email-service endpoint. Real SMTP credentials are set in Admin > Email Management.
SMTP_USER=

# --- Admin server control ---
# Path of the schedules file (default: backend/data/kiosk-schedules.json).
SCHEDULE_CONFIG_PATH=

# --- System health page ---
# Where Ollama listens (default http://127.0.0.1:11434).
OLLAMA_URL=

# --- Role 4 Bluetooth scanner (only the main server starts it) ---
# off (default) | on. Requires the Python environment and assets/requirements.txt.
BLUETOOTH_SCANNER=off
# Absolute Python executable; empty uses ../esg-bluetooth-venv/Scripts/python.exe on Windows.
BLUETOOTH_PYTHON=
# Signal threshold in dBm, not a distance in metres. Calibrate at the venue.
BLUETOOTH_RSSI_THRESHOLD=-75
# A reading older than this is no longer considered detected (milliseconds).
BLUETOOTH_TIMEOUT_MS=20000
